# Copiez ce fichier en .env.local puis renseignez les valeurs.
# En production, déclarez-les dans Vercel > projet > Settings > Environment Variables.

# URL publique de l'application (liens de paiement, e-mails, webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé serveur Supabase (service_role / secret). Ne jamais l'exposer au navigateur.
# Requise pour : paiement en ligne, webhook SasPay, tâche planifiée.
SUPABASE_SERVICE_ROLE_KEY=

# Secret de la tâche planifiée (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Paiement Mobile Money / carte via SasPay (https://docs.saspay.me)
# Compte SasPay de la PLATEFORME : n'encaisse que les abonnements des agences.
# Les loyers sont encaissés sur le compte SasPay de chaque agence (clé saisie dans Paramètres).
# Clé secrète : sk_test_… pour les essais (aucun argent réel), sk_live_… en production.
SASPAY_SECRET_KEY=
# Secret de signature du webhook (affiché UNE seule fois à la création du webhook dans SasPay).
SASPAY_WEBHOOK_SECRET=
# E-mail utilisé quand le payeur n'en a pas (SasPay en exige un).
SASPAY_FALLBACK_EMAIL=

# SMS via Infobip (optionnel). Sans clé, les SMS sont simulés (journalisés).
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com
